# Same Supabase project as the two web apps — one database, one set of
# accounts, so a tester signs in with credentials they already have.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The existing FastAPI backend. Defaults to the Render deployment; override
# to point at a local one.
EXPO_PUBLIC_API_BASE=https://goal-planning-app-mup2.onrender.com
# One-click sign-up: the web app whose /api/me/signups the Sign up tab uses.
EXPO_PUBLIC_APP_URL=https://app.autinerary.ca
