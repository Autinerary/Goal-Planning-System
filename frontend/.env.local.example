# Supabase Configuration (use the SAME credentials as ServiceHub for unified auth)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Goal Planning Backend API
API_URL=http://localhost:8000

# ServiceHub URL
NEXT_PUBLIC_SERVICE_HUB_URL=http://localhost:3001

# OpenAI — powers the Ideal Self AI portrait (/ideal-self). Server-side only.
# Optional: without it, the portrait generator shows a graceful "not configured" note.
OPENAI_API_KEY=your-openai-api-key
# Optional image model override (default: dall-e-3). e.g. gpt-image-1
# OPENAI_IMAGE_MODEL=dall-e-3
