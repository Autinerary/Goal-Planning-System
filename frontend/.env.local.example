# Supabase Configuration (use the SAME credentials as ServiceHub for unified auth)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Goal Planning Backend API
API_URL=http://localhost:8000

# ServiceHub URL
NEXT_PUBLIC_SERVICE_HUB_URL=http://localhost:3001

# OpenAI — powers the Ideal Self AI portrait (/ideal-self). Server-side only.
# Optional: without it, the portrait generator shows a graceful "not configured" note.
OPENAI_API_KEY=your-openai-api-key
# Optional image model override (default: dall-e-3). e.g. gpt-image-1
# OPENAI_IMAGE_MODEL=dall-e-3

# Email (Resend). Without it, reminder and check-in emails are not sent.
# RESEND_API_KEY=
# NEXT_PUBLIC_APP_URL=https://goal-planning-app.vercel.app
# Vercel sends this to the daily cron routes; they refuse other callers when set.
# CRON_SECRET=
# Optional: key for signing check-in email links. Defaults to one derived
# from SUPABASE_SERVICE_ROLE_KEY.
# CHECKIN_SECRET=

# Google sign-in. Turn on the Google provider in Supabase (Authentication >
# Providers > Google) and add <site>/auth/callback to its redirect URLs first.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Notifications (Web Push). One key pair for the app: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact the browsers' push services can reach, mailto: or https:
# VAPID_SUBJECT=mailto:aayush@autinerary.ca
